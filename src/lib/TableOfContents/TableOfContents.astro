---
import type { MarkdownHeading } from "astro";

import { Link } from "../Link";

import { HeadingsIntersectionHighlight } from "./HeadingsIntersectionHighlight";
import { PostProgressBar } from "./PostProgressBar";
import { TOP_HEADING_ID } from "../TOP_HEADING_ID";

export interface Props {
  headings: MarkdownHeading[];
  title: string;
}

const { headings, title } = Astro.props as Props;
const tocShown = headings.length > 2;

// we add a heading with depth 1 to the top so the reader can navigate to the top of the page
if (!headings.some((heading) => heading.depth === 1)) {
  headings.unshift({ depth: 1, slug: TOP_HEADING_ID, text: title });
}
---

{
  tocShown && (
    <section class="fixed top-16 left-[max(0px,calc(50%-43rem/2-20rem-1rem))] hidden max-h-full w-[calc(20rem-(var(--wide-content-width)-var(--container-width))/2)] overflow-y-auto p-4 pr-0 xl:block">
      <PostProgressBar client:media="(min-width: 1280px)">
        <ul
          id="table-of-contents"
          class="text-sm leading-6 text-gray-700 dark:text-gray-400"
        >
          {headings.map(({ text, depth, slug }) => {
            if (depth > 3) return null;

            return (
              <li class:list={{ "ml-4": depth === 3, truncate: depth === 1 }}>
                <Link
                  noUnderline
                  href={"#" + slug}
                  title={depth === 1 ? text : undefined}
                  class="dark:current:text-white current:text-black current:font-semibold"
                >
                  {text}
                </Link>
              </li>
            );
          })}
        </ul>
      </PostProgressBar>
      <HeadingsIntersectionHighlight
        headings={headings}
        client:media="(min-width: 1280px)"
      />
    </section>
  )
}

<style>
  @reference "../../global-styles/base.css";
  #table-of-contents:has(a:hover) {
    & a:not(:hover) {
      @apply text-gray-600 transition-colors;
      :global(.dark) & {
        @apply text-gray-500;
      }
    }

    & a:hover {
      :global(.dark) & {
        @apply text-gray-300;
      }
    }
  }
</style>
