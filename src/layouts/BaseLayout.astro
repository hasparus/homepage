---
import brygadaPath from "@fontsource-variable/brygada-1918/files/brygada-1918-latin-wght-italic.woff2";
import interPath from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2";

import Analytics from "../lib/Analytics.astro";
import InitColorScheme from "../lib/color-scheme/InitColorScheme.astro";
import { Commands } from "../lib/Commands";
import GrainOverlay from "../lib/GrainOverlay/GrainOverlay.astro";
import { orderedPosts } from "../build-time/posts";
import { Link } from "../lib/Link";
import ScrollbarStyles from "../lib/ScrollbarStyles.astro";
import { AUTHOR, SITE_NAME } from "../lib/siteMeta";
import { websiteSchema } from "../lib/seo/jsonLd";
import JsonLd from "../lib/seo/JsonLd.astro";
import SocialCardMetaTags from "../lib/SocialCardMetaTags.astro";

import "../global-styles/base.css";
import "../global-styles/controls.css";
import "../global-styles/font.css";
import "../global-styles/integrations.css";
import "../lib/prose/prose.css";
import "../own/own-additions.css";

interface Props {
  title: string;
  description: string;
  children: astroHTML.JSX.Element;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const posts = orderedPosts.map(({ module: { frontmatter } }) => ({
  href: frontmatter.path,
  title: frontmatter.title,
  date: frontmatter.date,
}));

const postPaths = new Set(posts.map((p) => p.href));

// Normalize trailing slash before lookup
const rawPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isPostRoute = postPaths.has(rawPathname);

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

const markdownAlt = Astro.site
  ? new URL(rawPathname + ".md", Astro.site).href
  : rawPathname + ".md";

const websiteData = websiteSchema({
  name: SITE_NAME,
  url: Astro.site ? Astro.site.href : Astro.url.origin + "/",
  author: AUTHOR,
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {
      [interPath, brygadaPath].map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }

    <SocialCardMetaTags ogImage={ogImage ?? "https://haspar.us/og.png"} />
    <meta property="og:type" content={isPostRoute ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    {
      (isPostRoute || rawPathname === "/") && (
        <link
          rel="alternate"
          type="text/markdown"
          href={
            rawPathname === "/" ? "https://haspar.us/index.md" : markdownAlt
          }
        />
      )
    }
    <link
      rel="service-desc"
      type="application/vnd.oai.openapi+json"
      href="/openapi.json"
    />
    <link rel="help" href="/docs/" />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
    <JsonLd data={websiteData} />
    <JsonLd data={{ "@context": "https://schema.org", ...AUTHOR }} />
    <slot name="head" />
    <InitColorScheme />
    <Analytics />
  </head>
  <body>
    <div class="max-w-container mx-auto px-4">
      <header
        class="-mt-2 flex items-center justify-between"
        style={{ height: "37.5px" }}
      >
        <slot name="header-content">
          <Link href="/">← back</Link>
        </slot>
        <Commands client:load posts={posts} />
      </header>
      <slot />
      <GrainOverlay opacity={0.25} />
    </div>
    <ScrollbarStyles />
  </body>
</html>
