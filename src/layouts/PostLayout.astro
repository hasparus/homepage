---
import type { MarkdownLayoutProps } from "astro";

import { socialCardOf } from "../lib/createOgImageLink";
import { formatDate } from "../lib/formatDate";
import { resolvePostImages } from "../lib/postImages";
import Image, { WIDE_CONTAINER_WIDTH } from "../lib/prose/Image.astro";
import { blogPostingSchema } from "../lib/seo/jsonLd";
import JsonLd from "../lib/seo/JsonLd.astro";
import { AUTHOR } from "../lib/siteMeta";
import TableOfContents from "../lib/TableOfContents/TableOfContents.astro";
import { TOP_HEADING_ID } from "../lib/TOP_HEADING_ID";
import type { PostFrontmatter } from "../types";

import BaseLayout from "./BaseLayout.astro";

import "../global-styles/shiki.css";

// They're all accessible, but we're not using all of them, and I want to
// reuse PostLayout in other pages, so I'm just picking the ones I need.
interface AllPropsFromMarkdownLayout extends Omit<
  MarkdownLayoutProps<{}>,
  "frontmatter"
> {
  frontmatter: PostFrontmatter;
}

interface Props extends Pick<
  AllPropsFromMarkdownLayout,
  "frontmatter" | "headings"
> {
  /** The post's `.mdx` path, to resolve images next to it. Pages without images can omit it. */
  file?: string;
}

const { frontmatter, headings, file } = Astro.props;

const { img, og } = file
  ? await resolvePostImages(frontmatter, file)
  : { img: undefined, og: {} };
const socialCard = socialCardOf(frontmatter, og);
const readingTime = frontmatter.readingTime;
const date = new Date(frontmatter.date);
const description = frontmatter.description || "";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

const postSchema = blogPostingSchema({
  headline: frontmatter.title,
  datePublished: date.toISOString(),
  description: frontmatter.description,
  canonical,
  author: AUTHOR,
});
---

<BaseLayout
  title={frontmatter.title}
  socialCard={socialCard}
  description={description}
>
  <JsonLd data={postSchema} slot="head" />
  <main class="zaduma-prose py-4">
    <header
      class="flex flex-col items-start justify-between sm:flex-row sm:items-center"
    >
      <h1 id={TOP_HEADING_ID} class="!my-0">{frontmatter.title}</h1>

      <div class="text-right text-gray-600 dark:text-gray-400">
        {
          readingTime.minutes > 1 && (
            <>
              <span>{readingTime.text}</span>
              {" · "}
            </>
          )
        }
        <time
          datetime={date.toISOString()}
          class="tracking-tighter tabular-nums"
        >
          {formatDate(date)}
        </time>
      </div>
    </header>
    {
      img && (
        <Image
          alt=""
          src={img}
          format="webp"
          width={WIDE_CONTAINER_WIDTH}
          aspectRatio={2}
          class="aspect-[2]"
        />
      )
    }
    <slot />
  </main>
  <TableOfContents headings={headings} title={frontmatter.title} />
  <style is:global>
    /* make the spacing even when there's no callout nor image */
    .zaduma-prose > header + :is(p, .zaduma-aside) {
      margin-top: 2em;
    }
  </style>
</BaseLayout>
