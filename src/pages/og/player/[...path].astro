---
import { allPosts } from "../../../build-time/posts";
import { ogVideoOf, playerPathOf } from "../../../lib/createOgImageLink";

export const getStaticPaths = () =>
  allPosts.flatMap(({ module: { frontmatter } }) => {
    const src = ogVideoOf(frontmatter);
    return src
      ? [{ params: { path: playerPathOf(frontmatter) }, props: { src } }]
      : [];
  });

const { src } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width" />
    <title>video</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #000;
      }
      video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    </style>
  </head>
  <body>
    <video src={src} autoplay loop muted playsinline></video>
  </body>
</html>
