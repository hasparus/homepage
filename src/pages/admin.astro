---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createOgImageLink } from "../lib/createOgImageLink";
import { Link } from "../lib/Link";
import { allPosts } from "../build-time/posts";

const linksToOGImages = allPosts.map(({ module }) =>
  createOgImageLink(module.frontmatter),
);
---

<BaseLayout
  title="admin"
  description="a page for inspecting and debugging OG images"
>
  <section class="py-10">
    <h1>OG Images</h1>
    <ul class="flex flex-col">
      {
        linksToOGImages.map((href) => (
          <li class="w-full">
            <Link
              href={href}
              noUnderline
              class="mx-0 my-0 flex w-full flex-row gap-2 text-sm break-all"
            >
              <span>{href}</span>
              <img
                width="320px"
                height="160px"
                class="h-[160px] w-[320px] border border-gray-600"
                src={href}
              />
            </Link>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
